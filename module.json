{
  "id": "settings-vault",
  "type": "module",
  "title": "Settings Vault",
  "description": "Export module settings to a file, read one back into another world, and see which modules have a newer release.",
  "version": "0.2.0",
  "compatibility": {
    "minimum": "14",
    "verified": "14"
  },
  "authors": [
    {
      "name": "fcsouza"
    }
  ],
  "esmodules": ["main.mjs"],
  "styles": [
    {
      "src": "styles/main.css",
      "layer": "modules"
    }
  ],
  "languages": [
    {
      "lang": "en",
      "name": "English",
      "path": "lang/en.json"
    }
  ],
  "flags": {
    "hotReload": {
      "extensions": ["css", "hbs", "json"],
      "paths": ["styles", "templates", "lang"]
    }
  },
  "url": "https://github.com/vttforge/settings-vault",
  "manifest": "https://github.com/vttforge/settings-vault/releases/latest/download/module.json",
  "bugs": "https://github.com/vttforge/settings-vault/issues",
  "readme": "README.md",
  "changelog": "CHANGELOG.md",
  "license": "LICENSE"
}
